---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_CONFIG, EDITIONS, CLOUD_PROVIDERS } from '../config/site';
---

<Layout title="PulsarOS Bittenfruit — Apple-Style Marketing Prototype">
  <div id="prototype-root" class="min-h-screen bg-[var(--color-surface-default)] text-[var(--color-on-surface-default)] font-[var(--font-text)] antialiased selection:bg-[var(--color-primary)]/20 selection:text-[var(--color-primary)]">

    <!-- Sticky Minimal Nav -->
    <header class="sticky top-0 z-50 bg-[var(--color-surface-default)]/80 backdrop-blur-md border-b border-[var(--color-neutral-100)] transition-colors">
      <div class="max-w-[1024px] mx-auto px-6 h-12 flex items-center justify-between text-[13px] font-[var(--font-text)]">
        <a href="/prototype" class="font-semibold text-[var(--color-on-surface-default)] hover:opacity-80 transition-opacity tracking-tight">
          PulsarOS Bittenfruit
        </a>
        <nav class="flex items-center gap-6 text-[var(--color-on-surface-muted)]">
          <a href="#overview" class="hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Overview</a>
          <a href="#shell" class="hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Experience</a>
          <a href="#debian-core" class="hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Debian Core</a>
          <a href="#compatibility" class="hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Apps</a>
          <a 
            href={SITE_CONFIG.releasesUrl} 
            target="_blank" 
            rel="noopener" 
            class="bg-[var(--color-primary)] text-[var(--color-on-surface-inverse)] rounded-[var(--radius-full)] px-3 py-1 text-[12px] font-medium hover:bg-[var(--primary-hover)] transition-colors"
          >
            Download ISO
          </a>
        </nav>
      </div>
    </header>

    <main>

      <!-- 1. HERO SECTION -->
      <section id="overview" class="pt-[60px] pb-[80px] sm:pt-[102px] sm:pb-[102px] px-6 text-center bg-[var(--color-surface-default)] border-b border-[var(--color-neutral-100)]">
        <div class="max-w-[800px] mx-auto flex flex-col items-center">
          
          <span class="gsap-hero-title text-[13px] font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-3 inline-block">
            PulsarOS Bittenfruit Edition
          </span>

          <h1 class="gsap-hero-title text-[40px] sm:text-[56px] font-bold font-[var(--font-display)] tracking-tight text-[var(--color-on-surface-default)] leading-[1.05] mb-4 text-balance">
            Power. Precision.<br />
            Pure macOS on Linux.
          </h1>

          <p class="gsap-hero-subhead text-[20px] sm:text-[24px] font-normal text-[var(--color-on-surface-muted)] max-w-[620px] leading-[1.35] mb-8 text-balance">
            Lightweight, stable, and secure Debian core packaged into an authentic macOS desktop experience.
          </p>

          <!-- Paired CTA Row -->
          <div class="gsap-hero-cta flex flex-row items-center justify-center gap-4 mb-14">
            <a 
              href={SITE_CONFIG.releasesUrl} 
              target="_blank" 
              rel="noopener" 
              class="bg-[var(--color-primary)] text-[var(--color-on-surface-inverse)] rounded-[var(--radius-full)] px-[21px] py-[11px] min-h-[44px] inline-flex items-center justify-center font-[var(--font-text)] text-[17px] hover:bg-[var(--primary-hover)] transition-colors"
            >
              Download ISO
            </a>
            <a 
              href="#shell" 
              class="bg-transparent text-[var(--color-secondary)] border border-[var(--color-secondary)] rounded-[var(--radius-full)] px-[21px] py-[11px] min-h-[44px] inline-flex items-center justify-center font-[var(--font-text)] text-[17px] hover:bg-[var(--color-secondary)]/5 transition-colors"
            >
              Explore features
            </a>
          </div>

          <!-- Product Desktop Visual -->
          <div class="gsap-hero-visual w-full max-w-[960px] mx-auto rounded-[var(--radius-xl)] bg-[var(--color-surface-muted)] p-3 border border-[var(--color-neutral-100)] shadow-sm origin-top">
            <div class="rounded-[var(--radius-lg)] overflow-hidden bg-black aspect-video relative border border-[var(--color-neutral-100)]">
              <img 
                src="/assets/desktop.png" 
                alt="PulsarOS Bittenfruit macOS Desktop Preview" 
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

        </div>
      </section>

      <!-- 2. LIQUID GLASS SHELL SECTION -->
      <section id="shell" class="py-[80px] sm:py-[102px] px-6 bg-[var(--color-surface-muted)] border-b border-[var(--color-neutral-100)]">
        <div class="max-w-[960px] mx-auto">
          
          <div class="gsap-section-reveal text-center max-w-[680px] mx-auto mb-16">
            <span class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-2 block">
              Refined Desktop Experience
            </span>
            <h2 class="text-[34px] sm:text-[40px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] tracking-tight leading-[1.1]">
              Crafted down to the smallest pixel.
            </h2>
            <p class="text-[17px] sm:text-[20px] text-[var(--color-on-surface-muted)] mt-4 leading-[1.35]">
              Liquid Glass rhythm, smooth gesture navigation, and instant Spotlight search designed for workflow speed.
            </p>
          </div>

          <!-- Feature Grid -->
          <div class="gsap-card-grid grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <div class="gsap-card-item bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] flex flex-col justify-between">
              <div>
                <span class="text-[13px] font-medium text-[var(--color-secondary)] uppercase tracking-wider block mb-2">01 — Session Restore</span>
                <h3 class="text-[24px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] mb-2">Continuity & Workspace Resume</h3>
                <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4] mb-6">
                  Reboot or wake up, and your workspace instantly reopens every window, arrangement, and session exactly where you left off.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <img src="/assets/desktop.png" alt="Session Restore" class="w-full h-full object-cover" />
              </div>
            </div>

            <div class="gsap-card-item bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] flex flex-col justify-between">
              <div>
                <span class="text-[13px] font-medium text-[var(--color-secondary)] uppercase tracking-wider block mb-2">02 — Universal Search</span>
                <h3 class="text-[24px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] mb-2">Spotlight Command Center</h3>
                <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4] mb-6">
                  Launch apps, query system settings, perform rapid math calculations, and manage clipboard history with standard `Cmd + Space`.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <img src="/assets/spotlight.png" alt="Spotlight Search" class="w-full h-full object-cover" />
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- 3. DEBIAN CORE & SECURITY SECTION -->
      <section id="debian-core" class="py-[80px] sm:py-[102px] px-6 bg-[var(--color-surface-default)] border-b border-[var(--color-neutral-100)]">
        <div class="max-w-[960px] mx-auto">
          
          <div class="gsap-section-reveal text-center max-w-[680px] mx-auto mb-16">
            <span class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-2 block">
              Rock-Solid Architecture
            </span>
            <h2 class="text-[34px] sm:text-[40px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] tracking-tight leading-[1.1]">
              Debian stability. Modern performance.
            </h2>
            <p class="text-[17px] sm:text-[20px] text-[var(--color-on-surface-muted)] mt-4 leading-[1.35]">
              Engineered on Debian Stable for zero-bloat operation, low memory usage, and enterprise security.
            </p>
          </div>

          <!-- Cards Grid -->
          <div class="gsap-card-grid grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] mb-2">Zero Telemetry</h3>
                <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                  Your data remains yours. No background telemetry, no forced account sign-ins, 100% private.
                </p>
              </div>
            </div>

            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] mb-2">Lightweight Footprint</h3>
                <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                  Runs efficiently on old and new hardware alike with under 1.2 GB RAM usage at idle.
                </p>
              </div>
            </div>

            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6 flex flex-col justify-between">
              <div>
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] mb-2">Local Sayri AI</h3>
                <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                  Integrated AI assistant running strictly on your local GPU. Zero cloud dependency.
                </p>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- 4. APP & SYSTEM COMPATIBILITY -->
      <section id="compatibility" class="py-[80px] sm:py-[102px] px-6 bg-[var(--color-surface-muted)] border-b border-[var(--color-neutral-100)]">
        <div class="max-w-[960px] mx-auto">
          
          <div class="gsap-section-reveal text-center max-w-[680px] mx-auto mb-16">
            <span class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-2 block">
              Ecosystem & Apps
            </span>
            <h2 class="text-[34px] sm:text-[40px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] tracking-tight leading-[1.1]">
              Every platform. One desktop.
            </h2>
            <p class="text-[17px] sm:text-[20px] text-[var(--color-on-surface-muted)] mt-4 leading-[1.35]">
              Execute Linux, macOS, Windows, and Android applications seamlessly.
            </p>
          </div>

          <div class="gsap-card-grid grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
            
            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)]">MacBoat</h3>
                <img src="/logos/macboat.png" alt="MacBoat" class="w-8 h-8 object-contain" />
              </div>
              <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                Preconfigured OpenCore VM engine to run macOS software directly on Linux.
              </p>
            </div>

            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)]">WinBoat</h3>
                <img src="/logos/winboat.svg" alt="WinBoat" class="w-8 h-8 object-contain" />
              </div>
              <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                Seamless Windows app launcher without Wine setup friction or multi-booting.
              </p>
            </div>

            <div class="gsap-card-item bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] rounded-[var(--radius-md)] p-6">
              <div class="flex items-center justify-between mb-4">
                <h3 class="text-[20px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)]">DroidTux</h3>
                <img src="/logos/droidtux.png" alt="DroidTux" class="w-8 h-8 object-contain" />
              </div>
              <p class="text-[15px] text-[var(--color-on-surface-muted)] leading-[1.4]">
                Run Android mobile applications side-by-side with desktop trackpad & mouse support.
              </p>
            </div>

          </div>

          <!-- Cloud Providers Bar -->
          <div class="text-center pt-8 border-t border-[var(--color-neutral-100)]">
            <span class="text-[13px] font-semibold uppercase tracking-wider text-[var(--color-on-surface-muted)] mb-4 block">
              Native Finder integration with 55+ Cloud Providers
            </span>
            <div class="flex flex-wrap items-center justify-center gap-3">
              {CLOUD_PROVIDERS.map((provider) => (
                <div class="flex items-center gap-2 px-3 py-1.5 rounded-[var(--radius-sm)] bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)]">
                  <img src={provider.logo} alt={provider.name} class="w-4 h-4 object-contain" />
                  <span class="text-[13px] font-medium text-[var(--color-on-surface-default)]">{provider.name}</span>
                </div>
              ))}
            </div>
          </div>

        </div>
      </section>

      <!-- 5. FINAL DOWNLOAD CTA SECTION -->
      <section class="py-[80px] sm:py-[102px] px-6 bg-[var(--color-surface-default)] text-center">
        <div class="max-w-[620px] mx-auto">
          <h2 class="text-[34px] sm:text-[40px] font-semibold font-[var(--font-display)] text-[var(--color-on-surface-default)] tracking-tight leading-[1.1] mb-4">
            Experience PulsarOS Bittenfruit.
          </h2>
          <p class="text-[17px] sm:text-[20px] text-[var(--color-on-surface-muted)] mb-8 leading-[1.35]">
            Free, open source, and built for performance. Download the ISO today.
          </p>
          <div class="flex flex-row items-center justify-center gap-4">
            <a 
              href={SITE_CONFIG.releasesUrl} 
              target="_blank" 
              rel="noopener" 
              class="bg-[var(--color-primary)] text-[var(--color-on-surface-inverse)] rounded-[var(--radius-full)] px-[21px] py-[11px] min-h-[44px] inline-flex items-center justify-center font-[var(--font-text)] text-[17px] hover:bg-[var(--primary-hover)] transition-colors"
            >
              Download Bittenfruit ISO
            </a>
          </div>
        </div>
      </section>

    </main>

    <!-- Quiet Minimal Apple-style Footer -->
    <footer class="py-8 border-t border-[var(--color-neutral-100)] bg-[var(--color-surface-muted)] text-[12px] text-[var(--color-on-surface-muted)]">
      <div class="max-w-[1024px] mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <p>© 2026 PulsarOS Bittenfruit Project. Open Source under GPL v3.</p>
        <div class="flex gap-6">
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:underline">GitHub</a>
          <a href="/" class="hover:underline">Main Site</a>
        </div>
      </div>
    </footer>

  </div>
</Layout>

<script>
  import { initHeroReveal, cleanupHeroReveal } from '../animations/hero-reveal';
  import { initScrollReveal, cleanupScrollReveal } from '../animations/scroll-reveal';

  function initPage() {
    const root = document.getElementById('prototype-root');
    if (!root) return;

    initHeroReveal(root);
    initScrollReveal(root);
  }

  function cleanupPage() {
    cleanupHeroReveal();
    cleanupScrollReveal();
  }

  document.addEventListener('astro:page-load', initPage);
  document.addEventListener('astro:before-swap', cleanupPage);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>
