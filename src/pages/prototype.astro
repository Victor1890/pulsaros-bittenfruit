---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import AppleMediaCardGallery from '../components/AppleMediaCardGallery.astro';
import { SITE_CONFIG, FAQS, EDITIONS, VIDEO_SHOWCASES, CLOUD_PROVIDERS } from '../config/site';
---

<Layout title="PulsarOS Bittenfruit — Ultimate Apple-Style Marketing Prototype">
  <div id="prototype-root" class="min-h-screen bg-[var(--color-surface-default)] text-[var(--color-on-surface-default)] font-[var(--font-text)] antialiased selection:bg-[var(--color-primary)]/20 selection:text-[var(--color-primary)]">
    
    <!-- 0. APPLE STICKY SUB-NAV BAR -->
    <div class="sticky top-0 z-40 bg-[var(--color-surface-default)]/80 backdrop-blur-xl border-b border-[var(--color-neutral-100)] text-[13px] py-3 px-4 sm:px-8 transition-colors">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href="/prototype" class="font-semibold text-sm sm:text-base text-[var(--color-on-surface-default)] hover:opacity-80 transition-opacity tracking-tight">
          PulsarOS Bittenfruit
        </a>
        <div class="flex items-center gap-4 sm:gap-6">
          <a href="#hero-trigger" class="text-[var(--color-on-surface-muted)] hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Overview</a>
          <a href="#interactive-story-section" class="text-[var(--color-on-surface-muted)] hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Features</a>
          <a href="#bento-section" class="text-[var(--color-on-surface-muted)] hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Bento Grid</a>
          <a href="#editions-section" class="text-[var(--color-on-surface-muted)] hover:text-[var(--color-on-surface-default)] transition-colors hidden sm:inline-block">Editions</a>
          <a 
            href={SITE_CONFIG.releasesUrl} 
            target="_blank" 
            rel="noopener" 
            class="bg-[var(--color-primary)] hover:bg-[var(--primary-hover)] text-[var(--color-on-surface-inverse)] font-medium px-4 py-1.5 rounded-[var(--radius-full)] transition-all text-xs shadow-xs hover:scale-105"
          >
            Download ISO
          </a>
        </div>
      </div>
    </div>

    <main class="overflow-x-hidden">

      <!-- PROTOTYPE BANNER -->
      <div class="bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] text-[var(--color-on-surface-inverse)] text-xs font-medium py-2 px-4 text-center border-b border-[var(--color-neutral-100)] flex items-center justify-center gap-3">
        <span class="px-2 py-0.5 rounded-[var(--radius-sm)] bg-black/20 text-white font-mono uppercase text-[10px] tracking-wider">Apple Fan Edition</span>
        <span>GSAP ScrollTrigger Pinned Zoom & All-Access Media Gallery</span>
        <a href="/" class="underline text-white font-semibold hover:opacity-80 ml-2">Main Site →</a>
      </div>

      <!-- 1. HERO SECTION WITH GSAP SCROLLTRIGGER PIN & SCREEN ZOOM -->
      <section id="hero-trigger" class="relative min-h-screen flex flex-col items-center justify-start pt-16 sm:pt-24 px-4 sm:px-6 text-center bg-[var(--color-surface-default)] border-b border-[var(--color-neutral-100)]">
        
        <!-- Hero Text Group -->
        <div id="hero-text" class="max-w-4xl mx-auto flex flex-col items-center z-10">
          <div class="mb-4">
            <span class="gsap-reveal-hero text-xs sm:text-sm font-semibold uppercase tracking-widest text-[var(--color-primary)] inline-block bg-[var(--color-primary)]/10 px-4 py-1 rounded-[var(--radius-full)] border border-[var(--color-primary)]/20">
              PulsarOS Bittenfruit
            </span>
          </div>

          <h1 class="gsap-reveal-hero text-5xl sm:text-7xl lg:text-8xl font-bold font-[var(--font-display)] tracking-tight text-[var(--color-on-surface-default)] leading-[1.03] mb-6 text-balance">
            Power. Precision.<br />
            <span class="bg-gradient-to-r from-[var(--color-on-surface-default)] via-[var(--color-on-surface-default)] to-[var(--color-on-surface-muted)] bg-clip-text text-transparent">
              Pure macOS on Linux.
            </span>
          </h1>

          <p class="gsap-reveal-hero text-lg sm:text-2xl text-[var(--color-on-surface-muted)] max-w-2xl font-normal leading-relaxed mb-8 text-balance">
            Engineered to replicate the exact visual design, animation rhythm, and desktop experience of macOS on Debian.
          </p>

          <div class="gsap-reveal-hero flex flex-col sm:flex-row items-center justify-center gap-5 mb-10">
            <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="apple-button-primary">
              Download Bittenfruit ISO
            </a>
            <a href="#interactive-story-section" class="apple-button-secondary">
              Explore features
            </a>
          </div>
        </div>

        <!-- Studio Display / Laptop Hardware Frame with Dynamic Zoom -->
        <div id="display-container" class="w-full max-w-5xl mx-auto mt-4 origin-top z-20">
          <div class="relative rounded-[var(--radius-xl)] bg-[var(--color-surface-elevated)] p-3 sm:p-4 shadow-xl border border-[var(--color-neutral-100)]">
            <div class="absolute top-2.5 left-1/2 -translate-x-1/2 size-2.5 rounded-full bg-black border border-white/20 z-20"></div>
            <div class="rounded-[var(--radius-lg)] overflow-hidden bg-black relative border border-black aspect-video shadow-inner">
              <video 
                id="hero-video"
                src="/videos/session-restore.mp4" 
                poster="/assets/desktop.png"
                autoplay 
                loop 
                muted 
                playsinline
                class="w-full h-full object-cover object-top"
              ></video>
            </div>
          </div>
          <div id="display-stand" class="w-36 h-4 bg-gradient-to-b from-[#272729] to-[#121214] mx-auto rounded-b-xl border-x border-b border-white/10 shadow-lg"></div>
        </div>

      </section>

      <!-- 2. APPLE ALL-ACCESS PASS MEDIA CARD GALLERY -->
      <AppleMediaCardGallery />

      <!-- 3. STICKY INTERACTIVE STORY SECTION (Apple Feature Sync) -->
      <section id="interactive-story-section" class="py-24 sm:py-36 bg-[var(--color-surface-default)] text-[var(--color-on-surface-default)] px-4 sm:px-6 relative border-t border-[var(--color-neutral-100)]">
        <div class="max-w-7xl mx-auto">
          
          <!-- Pure Apple Typography Section Title -->
          <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
            <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-3 block">
              Design & Engineering
            </span>
            <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-[var(--font-display)] tracking-tight leading-tight">
              Designed down to the smallest pixel.
            </h2>
            <p class="gsap-text-reveal mt-4 text-lg sm:text-xl text-[var(--color-on-surface-muted)] leading-relaxed">
              Every detail is modeled after commercial desktop operating systems.
            </p>
          </div>

          <!-- 2-Column Story Grid with Vertical Cards and Sticky Video -->
          <div id="story-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start relative">
            
            <!-- Left Column: Vertical Story Cards -->
            <div id="story-cards-column" class="lg:col-span-5 space-y-24 pt-4">
              
              <div class="story-card bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-primary)] transition-all duration-500 hover:border-[var(--color-primary)] cursor-pointer opacity-100" data-story-video="/videos/session-restore.mp4">
                <span class="text-xs font-mono text-[var(--color-primary)] uppercase tracking-wider block mb-2">01 — Continuity</span>
                <h3 class="text-2xl sm:text-3xl font-semibold font-[var(--font-display)] mb-3">Session Restore</h3>
                <p class="text-[var(--color-on-surface-muted)] leading-relaxed text-base">
                  Reboot or power on, and every application, window arrangement, and open document reopens instantly where you left off.
                </p>
              </div>

              <div class="story-card bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] transition-all duration-500 hover:border-[var(--color-primary)] cursor-pointer opacity-60" data-story-video="/videos/sayri.mp4">
                <span class="text-xs font-mono text-[var(--color-primary)] uppercase tracking-wider block mb-2">02 — Private Intelligence</span>
                <h3 class="text-2xl sm:text-3xl font-semibold font-[var(--font-display)] mb-3">Sayri AI Assistant</h3>
                <p class="text-[var(--color-on-surface-muted)] leading-relaxed text-base">
                  An intelligent assistant powered by local LLMs running straight on your GPU. 100% private, no telemetry, no cloud lock-in.
                </p>
              </div>

              <div class="story-card bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] transition-all duration-500 hover:border-[var(--color-primary)] cursor-pointer opacity-60" data-story-video="/videos/spotlight.mp4">
                <span class="text-xs font-mono text-[var(--color-primary)] uppercase tracking-wider block mb-2">03 — Search & Action</span>
                <h3 class="text-2xl sm:text-3xl font-semibold font-[var(--font-display)] mb-3">Spotlight Search</h3>
                <p class="text-[var(--color-on-surface-muted)] leading-relaxed text-base">
                  Command center for your machine. Search files, launch applications, calculate math, check clipboard history, or trigger system scripts.
                </p>
              </div>

              <div class="story-card bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] transition-all duration-500 hover:border-[var(--color-primary)] cursor-pointer opacity-60" data-story-video="/videos/window-mode.mp4">
                <span class="text-xs font-mono text-[var(--color-primary)] uppercase tracking-wider block mb-2">04 — Workspaces</span>
                <h3 class="text-2xl sm:text-3xl font-semibold font-[var(--font-display)] mb-3">Window Management</h3>
                <p class="text-[var(--color-on-surface-muted)] leading-relaxed text-base">
                  Split view, Mission Control gestures, full screen on dynamic workspaces, and fluid window snapping built for power users.
                </p>
              </div>

            </div>

            <!-- Right Column: Sticky Video Display -->
            <div id="story-video-container" class="lg:col-span-7 relative rounded-[var(--radius-lg)] overflow-hidden bg-black border border-[var(--color-neutral-100)] shadow-2xl aspect-video w-full z-20">
              <video 
                id="story-active-video"
                src="/videos/session-restore.mp4" 
                poster="/assets/desktop.png"
                autoplay 
                loop 
                muted 
                playsinline 
                class="w-full h-full object-cover transition-opacity duration-300"
              ></video>
              <div class="absolute bottom-4 left-4 bg-black/70 backdrop-blur-md px-3.5 py-1.5 rounded-[var(--radius-full)] border border-white/20 text-xs font-medium text-white flex items-center gap-2">
                <span class="size-2 rounded-full bg-[var(--color-primary)] animate-ping"></span>
                <span id="story-video-label">Live Feature Preview: Session Restore</span>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- 4. BENTO GRID SHOWCASE (Apple Bento Design) -->
      <section id="bento-section" class="py-24 sm:py-36 bg-[var(--color-surface-muted)] text-[var(--color-on-surface-default)] px-4 sm:px-6 relative border-t border-[var(--color-neutral-100)]">
        <div class="max-w-7xl mx-auto">
          
          <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
            <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-2 block">Comprehensive Suite</span>
            <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-[var(--font-display)] tracking-tight">
              Built for every workflow.
            </h2>
            <p class="gsap-text-reveal text-[var(--color-on-surface-muted)] text-lg sm:text-xl mt-4">
              Explore the core technologies powering PulsarOS Bittenfruit.
            </p>
          </div>

          <!-- Bento Grid Layout -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            
            <!-- Large Hero Bento Card (2 cols) -->
            <div class="gsap-bento-card md:col-span-2 bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 sm:p-12 border border-[var(--color-neutral-100)] flex flex-col justify-between overflow-hidden group hover:border-[var(--color-primary)]/40 transition-colors">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-2 block">Core Architecture</span>
                <h3 class="text-3xl sm:text-4xl font-semibold font-[var(--font-display)] mb-4">MacBoat Integration</h3>
                <p class="text-[var(--color-on-surface-muted)] text-base sm:text-lg leading-relaxed max-w-xl mb-8">
                  Run macOS in preconfigured OpenCore Virtual Machines directly using official Apple recovery servers with native performance.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <video src="/videos/window-mode.mp4" autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"></video>
              </div>
            </div>

            <!-- Bento Card 2 -->
            <div class="gsap-bento-card bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] flex flex-col justify-between group hover:border-[var(--color-primary)]/40 transition-colors">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Windows Apps</span>
                  <img src="/logos/winboat.svg" alt="WinBoat" class="size-7 object-contain" />
                </div>
                <h3 class="text-2xl font-semibold font-[var(--font-display)] mb-2">WinBoat</h3>
                <p class="text-[var(--color-on-surface-muted)] text-sm leading-relaxed mb-6">
                  Execute Windows software as native desktop windows with zero configuration or Wine headache.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <video src="/videos/app-store.mp4" autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"></video>
              </div>
            </div>

            <!-- Bento Card 3 -->
            <div class="gsap-bento-card bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] flex flex-col justify-between group hover:border-[var(--color-primary)]/40 transition-colors">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)]">Android Apps</span>
                  <img src="/logos/droidtux.png" alt="DroidTux" class="size-7 object-contain" />
                </div>
                <h3 class="text-2xl font-semibold font-[var(--font-display)] mb-2">DroidTux</h3>
                <p class="text-[var(--color-on-surface-muted)] text-sm leading-relaxed mb-6">
                  Run mobile Android apps side-by-side with full mouse, trackpad, and keyboard shortcuts.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <video src="/videos/sayri.mp4" autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"></video>
              </div>
            </div>

            <!-- Large Hero Bento Card (2 cols) -->
            <div class="gsap-bento-card md:col-span-2 bg-[var(--color-surface-default)] rounded-[var(--radius-lg)] p-8 sm:p-12 border border-[var(--color-neutral-100)] flex flex-col justify-between overflow-hidden group hover:border-[var(--color-primary)]/40 transition-colors">
              <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-[var(--color-primary)] mb-2 block">Visual Experience</span>
                <h3 class="text-3xl sm:text-4xl font-semibold font-[var(--font-display)] mb-4">Dynamic Wallpapers & Remap</h3>
                <p class="text-[var(--color-on-surface-muted)] text-base sm:text-lg leading-relaxed max-w-xl mb-8">
                  Live moving wallpapers on lockscreen and desktop paired with native macOS command key bindings out of the box.
                </p>
              </div>
              <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-[var(--color-surface-muted)]">
                <video src="/videos/remap-live-wallpaper.mp4" autoplay loop muted playsinline class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"></video>
              </div>
            </div>

          </div>

        </div>
      </section>

      <!-- 5. GSAP PINNED HORIZONTAL VIDEO CAROUSEL -->
      <section id="horizontal-section" class="py-24 bg-[var(--color-surface-default)] overflow-hidden border-t border-[var(--color-neutral-100)]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-12">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-primary)] block mb-2">Video Reel Showcase</span>
          <h2 class="text-3xl sm:text-5xl font-bold font-[var(--font-display)] tracking-tight">PulsarOS Bittenfruit Live Demos.</h2>
          <p class="text-[var(--color-on-surface-muted)] text-base mt-2">Scroll horizontally to inspect each live video feature.</p>
        </div>

        <!-- Horizontal Video Track -->
        <div id="horizontal-track-wrapper" class="w-full">
          <div id="horizontal-track" class="flex gap-6 px-6 w-max">
            {VIDEO_SHOWCASES.map((tile, i) => (
              <div class="w-[360px] sm:w-[480px] bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 border border-[var(--color-neutral-100)] flex flex-col justify-between shrink-0 hover:border-[var(--color-primary)]/40 transition-colors">
                <div>
                  <span class="text-xs font-mono text-[var(--color-primary)]">0{i + 1}</span>
                  <h3 class="text-2xl sm:text-3xl font-semibold font-[var(--font-display)] mt-1">{tile.title}</h3>
                  <p class="text-sm text-[var(--color-secondary)] font-medium mt-1 mb-3">{tile.subtitle}</p>
                  <p class="text-[var(--color-on-surface-muted)] text-sm leading-relaxed mb-6">{tile.description}</p>
                </div>
                <div class="rounded-[var(--radius-md)] overflow-hidden border border-[var(--color-neutral-100)] aspect-video bg-black">
                  <video src={tile.video} poster={tile.poster} autoplay loop muted playsinline class="w-full h-full object-cover"></video>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 6. CLOUD PROVIDERS LOGO BAR (Apple Ecosystem Style) -->
      <section class="py-20 bg-[var(--color-surface-muted)] px-4 sm:px-6 border-t border-[var(--color-neutral-100)]">
        <div class="max-w-5xl mx-auto text-center">
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-primary)] mb-3 block">
            Finder Integration
          </span>
          <h3 class="text-3xl sm:text-5xl font-bold font-[var(--font-display)] tracking-tight text-[var(--color-on-surface-default)] mb-4">
            Native Support for 55 Cloud Providers
          </h3>
          <p class="text-[17px] text-[var(--color-on-surface-muted)] max-w-xl mx-auto mb-10 leading-[1.35]">
            Access OneDrive, Google Drive, iCloud, Dropbox, Nextcloud, and Proton Drive directly inside Finder with zero sync latency.
          </p>

          <!-- Apple Signature Ecosystem Pills -->
          <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-4xl mx-auto">
            {CLOUD_PROVIDERS.map((provider) => (
              <div class="flex items-center gap-3 px-5 py-3 rounded-[var(--radius-full)] bg-[var(--color-surface-default)] border border-[var(--color-neutral-100)] shadow-2xs hover:shadow-md hover:scale-[1.03] hover:border-[var(--color-primary)]/30 transition-all duration-300 cursor-default">
                <img src={provider.logo} alt={provider.name} class="w-5 h-5 object-contain" />
                <span class="text-[15px] font-medium font-[var(--font-text)] text-[var(--color-on-surface-default)] tracking-tight">{provider.name}</span>
              </div>
            ))}
            
            <!-- Apple + More Badge Pill -->
            <div class="flex items-center gap-2 px-5 py-3 rounded-[var(--radius-full)] bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/20 text-[var(--color-primary)] font-medium text-[14px] cursor-default">
              <span class="size-1.5 rounded-full bg-[var(--color-primary)]"></span>
              <span>+ 47 More via Rclone</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. SIDE-BY-SIDE COMPARE EDITIONS -->
      <section id="editions-section" class="py-24 sm:py-32 bg-[var(--color-surface-default)] px-4 sm:px-6 border-t border-[var(--color-neutral-100)]">
        <div class="max-w-5xl mx-auto">
          <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-4xl sm:text-6xl font-bold font-[var(--font-display)] tracking-tight">Which Edition Fits You?</h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {EDITIONS.map((ed) => (
              <div class="bg-[var(--color-surface-muted)] rounded-[var(--radius-lg)] p-8 sm:p-12 border border-[var(--color-neutral-100)] flex flex-col justify-between hover:border-[var(--color-primary)]/40 transition-colors">
                <div>
                  <span class="text-xs font-semibold px-3 py-1 rounded-[var(--radius-full)] bg-[var(--color-primary)]/10 text-[var(--color-primary)] uppercase tracking-wider inline-block mb-4">{ed.badge}</span>
                  <h3 class="text-3xl font-semibold font-[var(--font-display)] mb-1">{ed.name}</h3>
                  <p class="text-base font-medium text-[var(--color-secondary)] mb-4">{ed.headline}</p>
                  <p class="text-sm text-[var(--color-on-surface-muted)] leading-relaxed mb-8">{ed.description}</p>
                  <ul class="space-y-3 mb-10 border-t border-[var(--color-neutral-100)] pt-6">
                    {ed.highlights.map((h) => (
                      <li class="flex items-center text-sm font-medium">
                        <svg class="size-4 text-[var(--color-primary)] mr-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                        {h}
                      </li>
                    ))}
                  </ul>
                </div>
                <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="apple-button-primary w-full text-center">Get {ed.name}</a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- 8. FAQ SECTION -->
      <section class="py-24 sm:py-32 bg-[var(--color-surface-muted)] px-4 sm:px-6 border-t border-[var(--color-neutral-100)]">
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-16">
            <h2 class="text-4xl sm:text-5xl font-bold font-[var(--font-display)] tracking-tight">Frequently Asked Questions</h2>
          </div>
          <div class="space-y-6">
            {FAQS.map((item) => (
              <div class="bg-[var(--color-surface-default)] rounded-[var(--radius-md)] p-8 border border-[var(--color-neutral-100)] hover:border-[var(--color-neutral-100)]/80 transition-colors">
                <h3 class="text-xl font-semibold font-[var(--font-display)] mb-3">{item.question}</h3>
                <p class="text-base text-[var(--color-on-surface-muted)] leading-relaxed">{item.answer}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

    </main>

    <Footer />

    <!-- FLOATING PROTOTYPE CONTROL BAR -->
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-[var(--color-surface-elevated)]/90 backdrop-blur-xl border border-[var(--color-neutral-100)] px-6 py-3 rounded-[var(--radius-full)] shadow-2xl flex items-center gap-4 text-xs">
      <span class="font-semibold flex items-center gap-2">
        <span class="size-2.5 rounded-full bg-[var(--color-primary)] animate-pulse"></span>
        Apple Fan Engine
      </span>
      <span class="text-[var(--color-on-surface-muted)]">|</span>
      <button id="btn-scroll-top" class="text-[var(--color-on-surface-muted)] hover:text-[var(--color-on-surface-default)] transition-colors font-medium cursor-pointer">Scroll to Top</button>
      <a href="/" class="text-[var(--color-primary)] font-semibold hover:underline ml-2">Main Site →</a>
    </div>

  </div>
</Layout>

<script>
  import { initHeroReveal, cleanupHeroReveal } from '../animations/hero-reveal';
  import { initScrollReveal, cleanupScrollReveal } from '../animations/scroll-reveal';
  import { initInteractiveStory, cleanupInteractiveStory } from '../animations/interactive-story';
  import { initHorizontalTrack, cleanupHorizontalTrack } from '../animations/horizontal-track';

  function initPage() {
    const root = document.getElementById('prototype-root');
    if (!root) return;

    initHeroReveal(root);
    initScrollReveal(root);
    initInteractiveStory(root);
    initHorizontalTrack(root);

    document.getElementById('btn-scroll-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  function cleanupPage() {
    cleanupHeroReveal();
    cleanupScrollReveal();
    cleanupInteractiveStory();
    cleanupHorizontalTrack();
  }

  document.addEventListener('astro:page-load', initPage);
  document.addEventListener('astro:before-swap', cleanupPage);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>
