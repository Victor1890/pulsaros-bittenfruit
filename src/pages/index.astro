---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import WorkflowsSection from '../components/WorkflowsSection.astro';
import EcosystemSection from '../components/EcosystemSection.astro';
import EditionsSection from '../components/EditionsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import { SITE_CONFIG } from '../config/site';
---

<Layout title={`${SITE_CONFIG.name} — ${SITE_CONFIG.brandTagline}`}>
  <div class="min-h-screen bg-[#ffffff] dark:bg-[#000000] text-[#1d1d1f] dark:text-[#f5f5f7] antialiased selection:bg-[#0071e3]/20 selection:text-[#0071e3]">
    <Header />
    <main>
      <HeroSection />
      <SolutionsSection />
      <WorkflowsSection />
      <EcosystemSection />
      <EditionsSection />
      <FAQSection />

      <!-- Apple Final CTA Banner -->
      <section class="py-24 sm:py-32 bg-[#ffffff] dark:bg-[#000000] text-center px-4 sm:px-6 border-t border-[#e5e7eb] dark:border-white/10">
        <div class="max-w-3xl mx-auto">
          <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] mb-6">
            Get PulsarOS Bitten Fruit.
          </h2>
          <p class="text-lg sm:text-xl text-[#86868b] max-w-xl mx-auto mb-10 leading-relaxed">
            Free, open source, and built by the community. Download the ISO and boot live without modifying your hard drive.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="apple-button-primary">
              Download ISO Now
            </a>
            <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="apple-link group text-base">
              <span>View Source Code</span>
              <svg class="size-4 text-[#0071e3] dark:text-[#2997ff] group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
