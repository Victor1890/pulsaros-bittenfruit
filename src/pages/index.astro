---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroSection from '../components/HeroSection.astro';
import AppleMediaCardGallery from '../components/AppleMediaCardGallery.astro';
import StorySection from '../components/StorySection.astro';
import BentoSection from '../components/BentoSection.astro';
import VideoReelSection from '../components/VideoReelSection.astro';
import CloudProvidersSection from '../components/CloudProvidersSection.astro';
import EditionsSection from '../components/EditionsSection.astro';
import FAQSection from '../components/FAQSection.astro';
import Footer from '../components/Footer.astro';
import FloatingControlBar from '../components/FloatingControlBar.astro';
import { SITE_CONFIG } from '../config/site';
---

<Layout title={`${SITE_CONFIG.name} — ${SITE_CONFIG.brandTagline}`}>
  <div id="main-root" class="min-h-screen bg-surface-default text-on-surface-default font-text antialiased selection:bg-primary/20 selection:text-primary">
    <Header />

    <main class="overflow-x-hidden">
      <HeroSection />
      <AppleMediaCardGallery />
      <StorySection />
      <BentoSection />
      <VideoReelSection />
      <CloudProvidersSection />
      <EditionsSection />
      <FAQSection />
    </main>

    <Footer />
    <FloatingControlBar />
  </div>
</Layout>

<script>
  import { initHeroReveal, cleanupHeroReveal } from '../animations/hero-reveal';
  import { initScrollReveal, cleanupScrollReveal } from '../animations/scroll-reveal';
  import { initInteractiveStory, cleanupInteractiveStory } from '../animations/interactive-story';
  import { initHorizontalTrack, cleanupHorizontalTrack } from '../animations/horizontal-track';

  function initPage() {
    const root = document.getElementById('main-root');
    if (!root) return;

    initHeroReveal(root);
    initScrollReveal(root);
    initInteractiveStory(root);
    initHorizontalTrack(root);

    document.getElementById('btn-scroll-top')?.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  function cleanupPage() {
    cleanupHeroReveal();
    cleanupScrollReveal();
    cleanupInteractiveStory();
    cleanupHorizontalTrack();
  }

  document.addEventListener('astro:page-load', initPage);
  document.addEventListener('astro:before-swap', cleanupPage);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
  } else {
    initPage();
  }
</script>
