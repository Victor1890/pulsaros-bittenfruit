---
import type { StoryFeature } from '@/types';
import { STORY_FEATURES } from '@/config/site';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  features?: StoryFeature[];
}

const {
  badge = "Design & Engineering",
  title = "Designed down to the smallest pixel.",
  subtitle = "Every detail is modeled after commercial desktop operating systems.",
  features = STORY_FEATURES
} = Astro.props;

const defaultVideo = features[0]?.video || "/videos/session-restore.mp4";
const defaultPoster = features[0]?.poster || "/assets/desktop.png";
const defaultLabel = features[0]?.title || "Session Restore";
---

<section id="interactive-story-section" class="hidden lg:block py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 relative border-t border-neutral-100">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">
        {badge}
      </span>
      <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight leading-tight">
        {title}
      </h2>
      <p class="gsap-text-reveal mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- 2-Column Story Grid with Vertical Cards and Sticky Video -->
    <div id="story-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start relative">
      
      <!-- Left Column: Vertical Story Cards -->
      <div id="story-cards-column" class="lg:col-span-5 space-y-24 pt-4">
        {features.map((item, index) => (
          <div 
            class={`story-card bg-surface-muted rounded-lg p-8 border transition-all duration-500 hover:border-primary cursor-pointer ${
              index === 0 ? 'border-primary opacity-100' : 'border-neutral-100 opacity-60'
            }`} 
            data-story-video={item.video}
          >
            <span class="text-xs font-mono text-primary uppercase tracking-wider block mb-2">
              {item.stepNumber} — {item.category}
            </span>
            <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">{item.title}</h3>
            <p class="text-on-surface-muted leading-relaxed text-base">
              {item.description}
            </p>
          </div>
        ))}
      </div>

      <!-- Right Column: Sticky Video Display -->
      <div id="story-video-container" class="lg:col-span-7 relative rounded-lg overflow-hidden bg-black border border-neutral-100 shadow-2xl aspect-video w-full z-20">
        <video 
          id="story-active-video"
          src={defaultVideo} 
          poster={defaultPoster}
          autoplay 
          loop 
          muted 
          playsinline 
          class="w-full h-full object-cover transition-opacity duration-300"
        ></video>
        <div class="absolute bottom-4 left-4 bg-black/70 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20 text-xs font-medium text-white flex items-center gap-2">
          <span class="size-2 rounded-full bg-primary animate-ping"></span>
          <span id="story-video-label">Live Feature Preview: {defaultLabel}</span>
        </div>
      </div>

    </div>

  </div>
</section>

<section id="intelligence" class="block lg:hidden py-24 sm:py-32 bg-surface-default text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <span class="text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">Next-Generation Desktop</span>
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-on-surface-default leading-tight">
        Intelligence built right in.
      </h2>
      <p class="mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        Session Restore and Sayri AI redefine how you interact with your operating system.
      </p>
    </div>

    <!-- Apple Campaign Cards Grid with Video Demos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {features.map((feat) => (
        <div class="bg-surface-muted rounded-3xl p-8 sm:p-12 border border-neutral-100 flex flex-col justify-between overflow-hidden group shadow-xs hover:border-primary/40 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-semibold uppercase tracking-widest text-primary">{feat.title}</span>
            </div>
            <h3 class="text-3xl sm:text-4xl font-semibold text-on-surface-default mb-4">{feat.title}</h3>
            <p class="text-on-surface-muted text-base sm:text-lg leading-relaxed mb-8">
              {feat.description}
            </p>
          </div>
          
          <div class="rounded-2xl overflow-hidden border border-neutral-100 bg-black aspect-video relative group-hover:border-primary/40 transition-colors">
            <video 
              src={feat.video} 
              poster={feat.poster}
              autoplay 
              loop 
              muted 
              playsinline 
              preload="metadata"
              class="w-full h-full object-cover"
            ></video>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>