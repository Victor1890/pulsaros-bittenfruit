---
// Interactive Story Section (Apple Feature Sync)
---

<section id="interactive-story-section" class="py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 relative border-t border-neutral-100">
  <div class="max-w-7xl mx-auto">
    
    <!-- Pure Apple Typography Section Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">
        Design & Engineering
      </span>
      <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight leading-tight">
        Designed down to the smallest pixel.
      </h2>
      <p class="gsap-text-reveal mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        Every detail is modeled after commercial desktop operating systems.
      </p>
    </div>

    <!-- 2-Column Story Grid with Vertical Cards and Sticky Video -->
    <div id="story-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start relative">
      
      <!-- Left Column: Vertical Story Cards -->
      <div id="story-cards-column" class="lg:col-span-5 space-y-24 pt-4">
        
        <div class="story-card bg-surface-muted rounded-lg p-8 border border-primary transition-all duration-500 hover:border-primary cursor-pointer opacity-100" data-story-video="/videos/session-restore.mp4">
          <span class="text-xs font-mono text-primary uppercase tracking-wider block mb-2">01 — Continuity</span>
          <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">Session Restore</h3>
          <p class="text-on-surface-muted leading-relaxed text-base">
            Reboot or power on, and every application, window arrangement, and open document reopens instantly where you left off.
          </p>
        </div>

        <div class="story-card bg-surface-muted rounded-lg p-8 border border-neutral-100 transition-all duration-500 hover:border-primary cursor-pointer opacity-60" data-story-video="/videos/sayri.mp4">
          <span class="text-xs font-mono text-primary uppercase tracking-wider block mb-2">02 — Private Intelligence</span>
          <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">Sayri AI Assistant</h3>
          <p class="text-on-surface-muted leading-relaxed text-base">
            An intelligent assistant powered by local LLMs running straight on your GPU. 100% private, no telemetry, no cloud lock-in.
          </p>
        </div>

        <div class="story-card bg-surface-muted rounded-lg p-8 border border-neutral-100 transition-all duration-500 hover:border-primary cursor-pointer opacity-60" data-story-video="/videos/spotlight.mp4">
          <span class="text-xs font-mono text-primary uppercase tracking-wider block mb-2">03 — Search & Action</span>
          <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">Spotlight Search</h3>
          <p class="text-on-surface-muted leading-relaxed text-base">
            Command center for your machine. Search files, launch applications, calculate math, check clipboard history, or trigger system scripts.
          </p>
        </div>

        <div class="story-card bg-surface-muted rounded-lg p-8 border border-neutral-100 transition-all duration-500 hover:border-primary cursor-pointer opacity-60" data-story-video="/videos/window-mode.mp4">
          <span class="text-xs font-mono text-primary uppercase tracking-wider block mb-2">04 — Workspaces</span>
          <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">Window Management</h3>
          <p class="text-on-surface-muted leading-relaxed text-base">
            Split view, Mission Control gestures, full screen on dynamic workspaces, and fluid window snapping built for power users.
          </p>
        </div>

      </div>

      <!-- Right Column: Sticky Video Display -->
      <div id="story-video-container" class="lg:col-span-7 relative rounded-lg overflow-hidden bg-black border border-neutral-100 shadow-2xl aspect-video w-full z-20">
        <video 
          id="story-active-video"
          src="/videos/session-restore.mp4" 
          poster="/assets/desktop.png"
          autoplay 
          loop 
          muted 
          playsinline 
          class="w-full h-full object-cover transition-opacity duration-300"
        ></video>
        <div class="absolute bottom-4 left-4 bg-black/70 backdrop-blur-md px-3.5 py-1.5 rounded-full border border-white/20 text-xs font-medium text-white flex items-center gap-2">
          <span class="size-2 rounded-full bg-primary animate-ping"></span>
          <span id="story-video-label">Live Feature Preview: Session Restore</span>
        </div>
      </div>

    </div>

  </div>
</section>
