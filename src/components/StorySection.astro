---
import type { StoryFeature } from '@/types';
import { STORY_FEATURES } from '@/config/site';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  features?: StoryFeature[];
}

const {
  title = "Designed down to the smallest pixel.",
  subtitle = "Every detail is modeled after commercial desktop operating systems.",
  features = STORY_FEATURES
} = Astro.props;

const defaultVideo = features[0]?.video || "/videos/session-restore.mp4";
const defaultPoster = features[0]?.poster || "/assets/desktop.png";
---

<section id="interactive-story-section" aria-label="Interactive Story Section" class="hidden lg:block py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 relative border-t border-neutral-100">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight leading-tight">
        {title}
      </h2>
      <p class="gsap-text-reveal mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        {subtitle}
      </p>
    </header>

    <!-- 2-Column Story Grid with Vertical Cards and Sticky Video -->
    <div id="story-grid-container" class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start relative">
      
      <!-- Left Column: Vertical Story Cards -->
      <div id="story-cards-column" class="lg:col-span-5 space-y-24 pt-4">
        {features.map((item, index) => (
          <article 
            id={item.id}
            class:list={[
              "story-card bg-surface-muted rounded-lg p-8 border transition-all duration-500 hover:border-primary cursor-pointer",
              {
                "border-primary opacity-100": index === 0,
                "border-neutral-100 opacity-60": index !== 0
              }
            ]}
            data-story-video={item.video}
          >
            <h3 class="text-2xl sm:text-3xl font-semibold font-display mb-3">{item.title}</h3>
            <p class="text-on-surface-muted leading-relaxed text-base">
              {item.description}
            </p>
          </article>
        ))}
      </div>

      <!-- Right Column: Sticky Video Display -->
      <figure id="story-video-container" class="lg:col-span-7 relative rounded-lg overflow-hidden bg-black border border-neutral-100 shadow-2xl aspect-video w-full z-20">
        <video 
          id="story-active-video"
          src={defaultVideo} 
          poster={defaultPoster}
          autoplay 
          loop 
          muted 
          playsinline 
          aria-label="Active Story Feature Video Preview"
          class="w-full h-full object-cover transition-opacity duration-300"
        ></video>
      </figure>

    </div>

  </div>
</section>

<section id="interactive-story-mobile" aria-label="Interactive Story Section Mobile" class="block lg:hidden py-24 sm:py-32 bg-surface-default text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-6xl mx-auto">
    
    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-on-surface-default leading-tight">
        Intelligence built right in.
      </h2>
      <p class="mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        Session Restore and Sayri AI redefine how you interact with your operating system.
      </p>
    </header>

    <!-- Apple Campaign Cards Grid with Video Demos -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      {features.map((feat) => (
        <article class="bg-surface-muted rounded-3xl p-8 sm:p-12 border border-neutral-100 flex flex-col justify-between overflow-hidden group shadow-xs hover:border-primary/40 transition-colors">
          <div>
            <h3 class="text-3xl sm:text-4xl font-semibold text-on-surface-default mb-4">{feat.title}</h3>
            <p class="text-on-surface-muted text-base sm:text-lg leading-relaxed mb-8">
              {feat.description}
            </p>
          </div>
          
          <figure class="rounded-2xl overflow-hidden border border-neutral-100 bg-black aspect-video relative group-hover:border-primary/40 transition-colors">
            <video 
              src={feat.video} 
              poster={feat.poster}
              autoplay 
              loop 
              muted 
              playsinline 
              preload="metadata"
              aria-label={`Video demo for ${feat.title}`}
              class="w-full h-full object-cover"
            ></video>
            <figcaption class="sr-only">Video demo for {feat.title}</figcaption>
          </figure>
        </article>
      ))}
    </div>

  </div>
</section>