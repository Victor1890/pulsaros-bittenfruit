---
import { CLOUD_PROVIDERS } from '../config/site';
---

<section class="py-20 bg-surface-muted px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-5xl mx-auto text-center">
    <span class="text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">
      Finder Integration
    </span>
    <h3 class="text-3xl sm:text-5xl font-bold font-display tracking-tight text-on-surface-default mb-4">
      Native Support for 55 Cloud Providers
    </h3>
    <p class="text-[17px] text-on-surface-muted max-w-xl mx-auto mb-10 leading-[1.35]">
      Access OneDrive, Google Drive, iCloud, Dropbox, Nextcloud, and Proton Drive directly inside Finder with zero sync latency.
    </p>

    <!-- Apple Signature Ecosystem Pills -->
    <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-4xl mx-auto">
      {CLOUD_PROVIDERS.map((provider) => (
        <div class="flex items-center gap-3 px-5 py-3 rounded-full bg-surface-default border border-neutral-100 shadow-xs hover:shadow-md hover:scale-[1.03] hover:border-primary/30 transition-all duration-300 cursor-default">
          <img src={provider.logo} alt={provider.name} class="size-5 object-contain" />
          <span class="text-[15px] font-medium font-text text-on-surface-default tracking-tight">{provider.name}</span>
        </div>
      ))}
      
      <!-- Apple + More Badge Pill -->
      <div class="flex items-center gap-2 px-5 py-3 rounded-full bg-primary/10 border border-primary/20 text-primary font-medium text-[14px] cursor-default">
        <span class="size-1.5 rounded-full bg-primary"></span>
        <span>+ 47 More via Rclone</span>
      </div>
    </div>
  </div>
</section>
