---
import { SITE_CONFIG } from '../config/site';
---

<!-- Global Apple Dark Header -->
<header class="sticky top-0 z-50 bg-[#000000]/85 backdrop-blur-xl border-b border-white/10 text-white transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between text-xs font-normal">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 text-white font-medium hover:opacity-80 transition-opacity">
      <svg class="size-4 text-white" viewBox="0 0 24 24" fill="currentColor">
        <circle cx="12" cy="12" r="9" />
      </svg>
      <span class="text-sm font-semibold tracking-tight">PulsarOS</span>
      <span class="text-[11px] text-[#86868b] font-medium hidden sm:inline">Bitten Fruit</span>
    </a>

    <!-- Subnav Links -->
    <nav class="hidden md:flex items-center gap-7 text-[#a1a1a6] font-normal">
      <a href="#overview" class="hover:text-white transition-colors">Overview</a>
      <a href="#intelligence" class="hover:text-white transition-colors">Intelligence</a>
      <a href="#features" class="hover:text-white transition-colors">Features</a>
      <a href="#connectivity" class="hover:text-white transition-colors">Connectivity</a>
      <a href="#editions" class="hover:text-white transition-colors">Compare</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ</a>
      <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:text-white transition-colors">GitHub</a>
    </nav>

    <!-- Action Button (Apple Pill) -->
    <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="inline-flex items-center justify-center px-4 py-1.5 rounded-full bg-[#0071e3] text-white font-medium hover:bg-[#0077ed] transition-colors text-xs">
      Download
    </a>
  </div>
</header>
