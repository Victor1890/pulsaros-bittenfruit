---
import { SITE_CONFIG } from '@/config/site';
---

<header class="sticky top-0 z-40 bg-surface-default/80 backdrop-blur-xl border-b border-neutral-100 text-[13px] py-3 px-4 sm:px-8 transition-colors">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <a href="/" class="font-semibold text-sm sm:text-base text-on-surface-default hover:opacity-80 transition-opacity tracking-tight">
      PulsarOS Bittenfruit
    </a>
    <nav class="flex items-center gap-4 sm:gap-6">
      <a href="#hero-trigger" class="text-on-surface-muted hover:text-on-surface-default transition-colors hidden sm:inline-block">Overview</a>
      <a href="#interactive-story-section" class="text-on-surface-muted hover:text-on-surface-default transition-colors hidden sm:inline-block">Features</a>
      <a href="#bento-section" class="text-on-surface-muted hover:text-on-surface-default transition-colors hidden sm:inline-block">Bento Grid</a>
      <a href="#editions-section" class="text-on-surface-muted hover:text-on-surface-default transition-colors hidden sm:inline-block">Editions</a>
      <a 
        href={SITE_CONFIG.releasesUrl} 
        target="_blank" 
        rel="noopener" 
        class="bg-primary hover:bg-primary-hover text-on-surface-inverse font-medium px-4 py-1.5 rounded-full transition-all text-xs shadow-xs hover:scale-105"
      >
        Download ISO
      </a>
    </nav>
  </div>
</header>
