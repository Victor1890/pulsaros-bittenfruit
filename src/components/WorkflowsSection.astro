---
import { VIDEO_SHOWCASES, CLOUD_PROVIDERS } from '@/config/site';
---

<section id="features" aria-label="Key Features & Finder Cloud Integration" class="py-24 sm:py-32 bg-[#f5f5f7] px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    
    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f] leading-tight">
        Everything you love about Mac.<br />
        Everything you need from Linux.
      </h2>
    </header>

    <!-- 2x2 Apple Product Tile Grid with Real Video Demos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
      {VIDEO_SHOWCASES.map((tile) => (
        <article class="bg-[#ffffff] rounded-3xl p-8 sm:p-10 border border-neutral-100 flex flex-col justify-between overflow-hidden group shadow-sm hover:border-primary/40 transition-colors">
          <div>
            <h3 class="text-2xl sm:text-3xl font-semibold text-[#1d1d1f]">{tile.title}</h3>
            <p class="text-sm sm:text-base font-medium text-primary mt-1 mb-3">{tile.subtitle}</p>
            <p class="text-on-surface-muted text-sm sm:text-base leading-relaxed mb-8">{tile.description}</p>
          </div>
          <figure class="rounded-2xl overflow-hidden border border-neutral-100 bg-[#000000] aspect-video">
            <video 
              src={tile.video} 
              poster={tile.poster}
              autoplay 
              loop 
              muted 
              playsinline 
              preload="metadata"
              aria-label={`Video showcase for ${tile.title}`}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            ></video>
            <figcaption class="sr-only">Video showcase for {tile.title}</figcaption>
          </figure>
        </article>
      ))}
    </div>

    <!-- Cloud Storage Providers Bar (Finder 55 Providers Integration) -->
    <div class="bg-[#ffffff] rounded-3xl p-8 sm:p-12 border border-neutral-100 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-primary mb-2 block">Finder Cloud Integration</span>
      <h3 class="text-2xl sm:text-4xl font-semibold text-[#1d1d1f] mb-3">55 Cloud Storage Providers Built-In</h3>
      <p class="text-sm sm:text-base text-on-surface-muted max-w-xl mx-auto mb-8">Access your files natively in Finder without downloading separate client apps.</p>

      <ul class="flex flex-wrap items-center justify-center gap-6 sm:gap-10">
        {CLOUD_PROVIDERS.map((provider) => (
          <li>
            <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-[#f5f5f7] border border-neutral-100 hover:border-primary/40 transition-colors">
              <img src={provider.logo} alt="" class="size-6 object-contain" aria-hidden="true" />
              <span class="text-xs font-semibold text-[#1d1d1f]">{provider.name}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
