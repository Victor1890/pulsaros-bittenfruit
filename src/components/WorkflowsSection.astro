---
import { VIDEO_SHOWCASES, CLOUD_PROVIDERS } from '@/config/site';
---

<section id="features" class="py-24 sm:py-32 bg-[#f5f5f7] dark:bg-[#161617] px-4 sm:px-6">
  <div class="max-w-6xl mx-auto">
    
    <div class="text-center max-w-3xl mx-auto mb-16 sm:mb-24">
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7] leading-tight">
        Everything you love about Mac.<br />
        Everything you need from Linux.
      </h2>
    </div>

    <!-- 2x2 Apple Product Tile Grid with Real Video Demos -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-24">
      {VIDEO_SHOWCASES.map((tile) => (
        <div class="bg-[#ffffff] dark:bg-[#000000] rounded-3xl p-8 sm:p-10 border border-[#e5e7eb] dark:border-white/10 flex flex-col justify-between overflow-hidden group shadow-sm">
          <div>
            <h3 class="text-2xl sm:text-3xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">{tile.title}</h3>
            <p class="text-sm sm:text-base font-medium text-[#0071e3] dark:text-[#2997ff] mt-1 mb-3">{tile.subtitle}</p>
            <p class="text-[#86868b] text-sm sm:text-base leading-relaxed mb-8">{tile.description}</p>
          </div>
          <div class="rounded-2xl overflow-hidden border border-[#e5e7eb] dark:border-white/10 bg-[#000000] aspect-video">
            <video 
              src={tile.video} 
              poster={tile.poster}
              autoplay 
              loop 
              muted 
              playsinline 
              preload="metadata"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            ></video>
          </div>
        </div>
      ))}
    </div>

    <!-- Cloud Storage Providers Bar (Finder 55 Providers Integration) -->
    <div class="bg-[#ffffff] dark:bg-[#000000] rounded-3xl p-8 sm:p-12 border border-[#e5e7eb] dark:border-white/10 text-center">
      <span class="text-xs font-semibold uppercase tracking-widest text-[#0071e3] dark:text-[#2997ff] mb-2 block">Finder Cloud Integration</span>
      <h3 class="text-2xl sm:text-4xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-3">55 Cloud Storage Providers Built-In</h3>
      <p class="text-sm sm:text-base text-[#86868b] max-w-xl mx-auto mb-8">Access your files natively in Finder without downloading separate client apps.</p>

      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10">
        {CLOUD_PROVIDERS.map((provider) => (
          <div class="flex items-center gap-2.5 px-4 py-2.5 rounded-2xl bg-[#f5f5f7] dark:bg-[#161617] border border-[#e5e7eb] dark:border-white/10 hover:border-[#0071e3]/40 transition-colors">
            <img src={provider.logo} alt={provider.name} class="size-6 object-contain" />
            <span class="text-xs font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">{provider.name}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
