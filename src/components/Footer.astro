---
import { SITE_CONFIG } from '../config/site';
---

<footer class="bg-[#f5f5f7] dark:bg-[#161617] text-[#86868b] text-[11px] py-12 border-t border-[#e5e7eb] dark:border-white/10">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <p class="mb-6 leading-relaxed border-b border-[#e5e7eb] dark:border-white/10 pb-6">
      1. PulsarOS is a Linux distribution project designed to replicate commercial operating system interfaces. The Bitten Fruit edition is developed independently by community contributors to reproduce the macOS user experience on Linux. macOS, Apple, and Mac are registered trademarks of Apple Inc. PulsarOS is not affiliated with, sponsored by, or endorsed by Apple Inc.
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>Copyright &copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Built by the community under GPL-3.0.</p>
      <div class="flex items-center gap-6">
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">GitHub Repository</a>
        <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="hover:text-[#1d1d1f] dark:hover:text-[#f5f5f7] transition-colors">Releases</a>
      </div>
    </div>
  </div>
</footer>
