---
import { SITE_CONFIG } from '@/config/site';
---

<!-- Apple Signature Minimal Editorial Footer -->
<footer class="bg-[#f5f5f7] text-on-surface-muted text-[12px] font-normal py-10 px-4 sm:px-6 border-t border-neutral-100 transition-colors">
  <div class="max-w-6xl mx-auto space-y-6">
    
    <!-- Legal / Footnotes Paragraph -->
    <div class="space-y-3 pb-6 border-b border-neutral-100 leading-relaxed">
      <p>
        1. PulsarOS Bitten Fruit is an independent open-source Linux distribution project. macOS, Mac, OpenCore, and Apple logo design elements are trademarks of Apple Inc., registered in the U.S. and other countries and regions.
      </p>
      <p>
        2. Hardware virtualization features (MacBoat, WinBoat, DroidTux) require compatible CPU hardware virtualization support (Intel VT-x or AMD-V) enabled in your BIOS/UEFI firmware.
      </p>
    </div>

    <!-- Main Navigation Columns -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 py-4">
      <div>
        <h3 class="font-semibold text-[#1d1d1f] mb-3 text-[13px]">Explore PulsarOS</h3>
        <ul class="space-y-2">
          <li><a href="#overview" class="hover:text-[#1d1d1f] transition-colors">Bitten Fruit Edition</a></li>
          <li><a href="#intelligence" class="hover:text-[#1d1d1f] transition-colors">Sayri AI Engine</a></li>
          <li><a href="#features" class="hover:text-[#1d1d1f] transition-colors">Spotlight Search</a></li>
          <li><a href="#connectivity" class="hover:text-[#1d1d1f] transition-colors">GSConnect Sync</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-[#1d1d1f] mb-3 text-[13px]">Virtualization</h3>
        <ul class="space-y-2">
          <li><a href="#features" class="hover:text-[#1d1d1f] transition-colors">MacBoat (OpenCore)</a></li>
          <li><a href="#features" class="hover:text-[#1d1d1f] transition-colors">WinBoat Virtualizer</a></li>
          <li><a href="#features" class="hover:text-[#1d1d1f] transition-colors">DroidTux Mobile</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-[#1d1d1f] mb-3 text-[13px]">Editions & Releases</h3>
        <ul class="space-y-2">
          <li><a href="#editions" class="hover:text-[#1d1d1f] transition-colors">Debian Stable Core</a></li>
          <li><a href="#editions" class="hover:text-[#1d1d1f] transition-colors">Arch Rolling Core</a></li>
          <li><a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="hover:text-[#1d1d1f] transition-colors">Download ISO</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-[#1d1d1f] mb-3 text-[13px]">Community</h3>
        <ul class="space-y-2">
          <li><a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:text-[#1d1d1f] transition-colors">GitHub Repository</a></li>
          <li><a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="hover:text-[#1d1d1f] transition-colors">Release Notes</a></li>
          <li><span class="text-[#a1a1a6]">License: {SITE_CONFIG.license}</span></li>
        </ul>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="pt-6 border-t border-neutral-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px]">
      <p>© {new Date().getFullYear()} {SITE_CONFIG.name}. Built with passion by the open-source community.</p>
      <div class="flex items-center gap-6">
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="hover:underline">GitHub</a>
        <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="hover:underline">Releases</a>
      </div>
    </div>

  </div>
</footer>
