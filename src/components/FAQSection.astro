---
import type { FAQItem } from '@/types';
import { FAQS, SITE_CONFIG } from '@/config/site';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  items?: FAQItem[];
}

const {
  badge = "Questions? Answers.",
  title = "Frequently Asked Questions",
  subtitle = "Everything you need to know about PulsarOS Bitten Fruit edition.",
  items = FAQS
} = Astro.props;
---

<section id="faq-section" class="py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-4xl mx-auto">
    
    <!-- Section Header -->
    <div class="mb-16">
      <span class="text-xs sm:text-sm font-semibold uppercase tracking-widest text-primary mb-3 block">
        {badge}
      </span>
      <h2 class="text-4xl sm:text-6xl font-bold font-display tracking-tight text-on-surface-default leading-tight">
        {title}
      </h2>
      <p class="mt-4 text-lg sm:text-xl text-on-surface-muted max-w-2xl font-normal leading-relaxed">
        {subtitle}
      </p>
    </div>

    <div class="border-t border-b border-neutral-100 divide-y divide-neutral-100">
      {items.map((item, index) => (
        <details 
          name="faq-accordion"
          data-faq-item
          class="group py-6 sm:py-8 cursor-pointer select-none transition-colors" 
          open={index === 0}
        >
          <summary class="flex items-center justify-between font-display text-xl sm:text-2xl font-semibold text-on-surface-default list-none group-hover:text-primary transition-colors">
            <span class="pr-6">{item.question}</span>
            <span class="shrink-0 size-8 sm:size-9 rounded-full bg-surface-muted flex items-center justify-center text-on-surface-muted group-open:rotate-45 group-open:bg-primary group-open:text-white transition-all duration-300 shadow-xs">
              <svg class="size-4 stroke-current stroke-[2.5]" viewBox="0 0 24 24" fill="none">
                <path d="M12 5v14M5 12h14" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          
          <!-- Animated Expandable Answer Box -->
          <div class="grid grid-rows-[0fr] opacity-0 group-open:grid-rows-[1fr] group-open:opacity-100 transition-[grid-template-rows,opacity] duration-300 ease-out">
            <div class="overflow-hidden">
              <div class="pt-4 text-base sm:text-lg text-on-surface-muted leading-relaxed max-w-3xl pr-12">
                <p>{item.answer}</p>
              </div>
            </div>
          </div>
        </details>
      ))}
    </div>

    <!-- Community callout: social links from os.inled.es -->
    <div class="mt-16 pt-8 border-t border-neutral-100">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h3 class="text-2xl sm:text-3xl font-semibold text-on-surface-default font-display">Talk to the humans behind it</h3>
        <p class="text-sm sm:text-base text-on-surface-muted mt-3 leading-relaxed">
          Stuck installing? Curious about something? Just want to say hi?
          <strong class="text-on-surface-default">Our community is friendly and we are around every day</strong> — for any doubt you may have, someone will answer.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="https://link.inled.es/discord" target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-[var(--radius-md)] border-2 border-primary bg-primary/5 p-5 hover:bg-primary/10 transition-colors">
          <span class="shrink-0 size-10 rounded-full bg-primary text-white flex items-center justify-center">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8083-.247-3.6177-.247-5.4812 0-.1637-.3933-.4055-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/></svg>
          </span>
          <span>
            <span class="block font-display font-semibold text-on-surface-default">Discord</span>
            <span class="block text-sm text-on-surface-muted">The busiest room. English and Spanish.</span>
          </span>
        </a>

        <a href="https://link.inled.es/telegram" target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-[var(--radius-md)] border border-neutral-100 bg-surface-muted p-5 hover:border-primary/40 transition-colors">
          <span class="shrink-0 size-10 rounded-full bg-surface-default border border-neutral-100 text-on-surface-default flex items-center justify-center">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.055-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </span>
          <span>
            <span class="block font-display font-semibold text-on-surface-default">Telegram</span>
            <span class="block text-sm text-on-surface-muted">Quick questions and news.</span>
          </span>
        </a>

        <a href="https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org" target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-[var(--radius-md)] border border-neutral-100 bg-surface-muted p-5 hover:border-primary/40 transition-colors">
          <span class="shrink-0 size-10 rounded-full bg-surface-default border border-neutral-100 text-on-surface-default flex items-center justify-center">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 4H3v16h2M19 4h2v16h-2"/><text x="12" y="16.5" text-anchor="middle" font-size="12" font-weight="bold" fill="currentColor" stroke="none" font-family="inherit">m</text></svg>
          </span>
          <span>
            <span class="block font-display font-semibold text-on-surface-default">Matrix</span>
            <span class="block text-sm text-on-surface-muted">Open and lightweight, for the curious.</span>
          </span>
        </a>

        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener" class="group flex items-center gap-4 rounded-[var(--radius-md)] border border-neutral-100 bg-surface-muted p-5 hover:border-primary/40 transition-colors">
          <span class="shrink-0 size-10 rounded-full bg-surface-default border border-neutral-100 text-on-surface-default flex items-center justify-center">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
          </span>
          <span>
            <span class="block font-display font-semibold text-on-surface-default">GitHub</span>
            <span class="block text-sm text-on-surface-muted">Peek at how it is all made.</span>
          </span>
        </a>
      </div>

      <p class="text-center text-sm text-on-surface-muted mt-8">
        Prefer to check it yourself? <a class="text-secondary hover:underline font-medium" href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener">Audit the code</a> — every line is public.
      </p>
    </div>

  </div>
</section>

<script>
  function initFaqAccordion() {
    const detailsElements = document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]');

    detailsElements.forEach((targetDetail) => {
      targetDetail.addEventListener('toggle', () => {
        if (targetDetail.open) {
          detailsElements.forEach((detail) => {
            if (detail !== targetDetail && detail.open) {
              detail.open = false;
            }
          });
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initFaqAccordion);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFaqAccordion);
  } else {
    initFaqAccordion();
  }
</script>
