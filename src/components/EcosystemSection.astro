---
import { ECOSYSTEM } from '@/config/site';
---

<section id="connectivity" aria-label="Ecosystem Connectivity and Integration" class="py-24 sm:py-32 bg-[#ffffff] px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-6xl mx-auto">
    
    <header class="text-center max-w-3xl mx-auto mb-16">
      <span class="text-xs font-semibold uppercase tracking-widest text-primary mb-3 block">Seamless Integration</span>
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f]">
        Works connected everywhere.
      </h2>
      <p class="mt-4 text-lg sm:text-xl text-on-surface-muted leading-relaxed">
        PulsarOS Bitten Fruit bridges macOS, Windows, and Android natively.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {ECOSYSTEM.map((item) => (
        <article class="bg-[#f5f5f7] rounded-3xl p-8 border border-neutral-100 flex flex-col justify-between hover:border-primary/40 transition-colors">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-medium text-primary uppercase tracking-wider">{item.tag}</span>
              <img src={item.logo} alt="" class="h-8 w-8 object-contain" aria-hidden="true" />
            </div>
            <h3 class="text-2xl font-semibold text-[#1d1d1f] mb-2">{item.name}</h3>
            <p class="text-sm font-medium text-[#1d1d1f] mb-3">{item.headline}</p>
            <p class="text-sm text-on-surface-muted leading-relaxed">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
