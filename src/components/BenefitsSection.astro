---
// Apple "Y mucho más." style: no cards — left-aligned icon, bold lead sentence,
// then body text, all grouped as plain text columns.
const benefits = [
  {
    title: "Always getting better.",
    description: "New versions, new apps and improvements arrive constantly. Your system moves forward the day it ships — and every day after.",
    icon: "M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Built to last.",
    description: "No planned obsolescence. Your computer does not expire here — a machine others have left behind keeps running for years.",
    icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z",
  },
  {
    title: "Completely free.",
    description: "No licenses, no subscriptions, no accounts. Download it, install it, use it. It costs nothing, today and always.",
    icon: "M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z",
  },
  {
    title: "Open source, nothing hidden.",
    description: "Every line of code is public. Anyone can read exactly what the system does, check it, improve it and share it. Trust built on transparency, not promises.",
    icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  },
  {
    title: "A new life for your old Mac.",
    description: "That Mac gathering dust in a drawer can feel new again — same comfort, same familiarity, years more of use.",
    icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  },
  {
    title: "Free, and still comfortable.",
    description: "Step out of the Apple ecosystem without giving up an ounce of comfort. Everything is where you expect it, the way you already know.",
    icon: "M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z",
  },
];
---

<section id="benefits-section" aria-label="Why Pulsar OS" class="py-24 sm:py-36 bg-surface-default text-on-surface-default px-4 sm:px-6 border-t border-neutral-100">
  <div class="max-w-7xl mx-auto">
    <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight mb-16 sm:mb-20">
      And much more.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-14">
      {benefits.map((benefit) => (
        <div class="gsap-bento-card flex flex-col items-start text-left">
          <div class="size-11 rounded-[var(--radius-md)] bg-primary/10 text-primary flex items-center justify-center mb-5">
            <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d={benefit.icon} />
            </svg>
          </div>
          <p class="text-on-surface-muted text-[15px] sm:text-base leading-relaxed">
            <strong class="text-on-surface-default font-semibold">{benefit.title}</strong>
            {' '}{benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
