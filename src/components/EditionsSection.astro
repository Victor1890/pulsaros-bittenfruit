---
import { EDITIONS, SITE_CONFIG } from '../config/site';
---

<section id="editions" class="py-24 sm:py-32 bg-[#f5f5f7] dark:bg-[#161617] px-4 sm:px-6">
  <div class="max-w-5xl mx-auto">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl sm:text-6xl font-semibold tracking-tight text-[#1d1d1f] dark:text-[#f5f5f7]">
        Which PulsarOS edition is right for you?
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {EDITIONS.map((ed) => (
        <div class="bg-[#ffffff] dark:bg-[#000000] rounded-3xl p-8 sm:p-12 border border-[#e5e7eb] dark:border-white/10 flex flex-col justify-between shadow-sm">
          <div>
            <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#0071e3]/10 text-[#0071e3] dark:text-[#2997ff] uppercase tracking-wider inline-block mb-4">{ed.badge}</span>
            <h3 class="text-3xl font-semibold text-[#1d1d1f] dark:text-[#f5f5f7] mb-1">{ed.name}</h3>
            <p class="text-base font-medium text-[#0071e3] dark:text-[#2997ff] mb-4">{ed.headline}</p>
            <p class="text-sm text-[#86868b] leading-relaxed mb-8">{ed.description}</p>
            
            <ul class="space-y-3 mb-10 border-t border-[#e5e7eb] dark:border-white/10 pt-6">
              {ed.highlights.map((h) => (
                <li class="flex items-center text-sm font-medium text-[#1d1d1f] dark:text-[#f5f5f7]">
                  <svg class="size-4 text-[#0071e3] dark:text-[#2997ff] mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                  {h}
                </li>
              ))}
            </ul>
          </div>

          <a href={SITE_CONFIG.releasesUrl} target="_blank" rel="noopener" class="apple-button-primary w-full text-center">
            Get {ed.name}
          </a>
        </div>
      ))}
    </div>

  </div>
</section>
