---
import type { BentoCard } from '@/types';
import { BENTO_CARDS } from '@/config/site';

interface Props {
  badge?: string;
  title?: string;
  subtitle?: string;
  cards?: BentoCard[];
}

// Structure and texts mirror the "Connected everywhere" ecosystem section on https://os.inled.es/bitten-fruit/
const {
  title = "Connected everywhere",
  subtitle = "Your other systems aren't islands. Bitten Fruit bridges macOS, Windows, and Android, natively.",
  cards = BENTO_CARDS
} = Astro.props;
---

<section id="bento-section" aria-label="Multiplatform ecosystem" class="py-24 sm:py-36 bg-surface-muted text-on-surface-default px-4 sm:px-6 relative border-t border-neutral-100">
  <div class="max-w-7xl mx-auto space-y-12">

    <header class="text-center max-w-3xl mx-auto mb-16 sm:mb-20">
      <h2 class="gsap-text-reveal text-4xl sm:text-6xl font-bold font-display tracking-tight">
        {title}
      </h2>
      <p class="gsap-text-reveal text-on-surface-muted text-lg sm:text-xl mt-4">
        {subtitle}
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {cards.map((card) => (
        <article class="gsap-bento-card bg-surface-default rounded-lg p-8 sm:p-10 border border-neutral-100 flex flex-col overflow-hidden group hover:border-primary/40 transition-colors">
          <div class="flex items-center gap-4 mb-4">
            {card.logo && <img src={card.logo} alt="" width="22" height="22" loading="lazy" class="size-6 object-contain" aria-hidden="true" />}
            <h3 class="text-2xl sm:text-3xl font-semibold font-display">{card.title}</h3>
          </div>
          <p class="text-on-surface-muted text-base leading-relaxed">
            {card.description}
          </p>
        </article>
      ))}
    </div>

  </div>
</section>
